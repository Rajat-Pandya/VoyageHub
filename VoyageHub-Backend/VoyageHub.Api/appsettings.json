{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AngularAuthDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "https://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "VoyageHub.Api",
    "Audience": "VoyageHub.Client",
    "ExpiryMinutes": 1440
  },
  "Swagger": {
    "Enabled": false
  }
}
